APP_NAME="HyperBit Social"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=es
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=es_ES

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Database - Use MySQL/MariaDB on Hostinger
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=hyperbit_social
DB_USERNAME=root
DB_PASSWORD=

# Session & Cache - Database driver for shared hosting (no Redis)
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

# Meta (Facebook/Instagram) API Configuration
# App ID is public, can be in .env.example
META_APP_ID=1127758050142770
# App Secret is PRIVATE - never commit the actual value!
META_APP_SECRET=your_app_secret_here
# Graph API version - update as needed
META_GRAPH_VERSION=v22.0

# Facebook Login for Business Configuration
# For Business-type Meta Apps, create a Login Configuration in the Meta Developer Console:
# Facebook Login for Business > Configurations > Create
# Select "User access token" and add permissions: pages_show_list, pages_manage_posts,
# pages_read_engagement, read_insights, instagram_basic, instagram_content_publish,
# instagram_manage_insights, business_management
# Then set the config ID here (required for Business apps):
META_LOGIN_CONFIG_ID=

# Fallback scopes (only used when META_LOGIN_CONFIG_ID is not set)
# Note: email scope is not used - users are identified by Facebook ID
META_SCOPES=pages_show_list,pages_manage_posts,pages_read_engagement,read_insights,instagram_basic,instagram_content_publish,instagram_manage_insights,business_management

# OAuth Redirect URI (must match Meta App settings)
META_REDIRECT_URI="${APP_URL}/auth/facebook/callback"

# Data Deletion Callback URL (must be registered in Meta App settings)
META_DATA_DELETION_URL="${APP_URL}/api/meta/data-deletion"

# Mail Configuration
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@hyperbitit.com"
MAIL_FROM_NAME="${APP_NAME}"

# Vite
VITE_APP_NAME="${APP_NAME}"
